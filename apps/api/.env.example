# Application
APP_NAME=SprintSync
ENVIRONMENT=development
DEBUG=false

# Security: must be at least 32 characters in production
SECRET_KEY=replace-with-256-bit-secret-minimum-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_TOKEN_EXPIRE_HOURS=8

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sprintsync

# Cache and queues
REDIS_URL=redis://localhost:6379

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_HEADERS=*

# Host security
ALLOWED_HOSTS=*
HSTS_ENABLED=false

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI platform
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=replace-me
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
OLLAMA_BASE_URL=http://localhost:11434

# Billing
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=sk-test-replace-me
STRIPE_PUBLISHABLE_KEY=pk-test-replace-me
STRIPE_WEBHOOK_SECRET=whsec-replace-me
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Communications
EMAIL_PROVIDER=console
RESEND_API_KEY=
SENDGRID_API_KEY=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=us-east-1
POSTMARK_API_KEY=
PUSH_PROVIDER=none
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
DEFAULT_LOCALE=en
